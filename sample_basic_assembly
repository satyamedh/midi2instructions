.device atmega328p

.equ DDRB = 4
.equ PORTB = 5

.equ TCCR1A = 0x80
.equ TCCR1B = 0x81
.equ TCNT1L = 0x84
.equ TCNT1H = 0x85
.equ OCR1AL = 0x88
.equ OCR1AH = 0x89

.def XL = r26
.def XH = r27

.def YL = r28
.def YH = r29

.def ZL = r30
.def ZH = r31

ldi r16,$3F ; 0011 1111 idk which one is pin 9
out DDRB,r16

ldi r16,$20 ; 0011 0000
out PORTB,r16

; test waiting for 1s
