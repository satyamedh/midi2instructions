; Z = r31:r30
; Z points to start of midi_events

ldi ZL, LOW(midi_events * 2)
ldi ZH, HIGH(midi_events * 2)

; Initialize counter
ldi r17, LOW(num_events)
ldi r18, HIGH(num_events)

next_item:
    ; use X for frequency, Y for duration
    ; read from Z, and increment after with Z+

    lpm XL, Z+ ; load low byte of frequency
    lpm XH, Z+ ; load high byte of frequency
    lpm YL, Z+ ; load low byte of duration
    lpm YH, Z+ ; load high byte of duration

    ; now, X = frequency, Y = duration

    ; just to check if it's loading properly and terminating
    ; mov r16,ZL
    ; rcall sendregisterstolaptop

    ; check if frequency is zero, which is for a wait event
    mov r16, XH
    or r16, XL
    breq wait_event

    ; frequency is not zero, so we need to play a note
    ; will write subroutine later TODO
    ; for now,

    rcall play_note
    rjmp finisher

wait_event:
    ; wait for duration in Y
    rcall wait_duration

finisher:
    ; decrement counter
    ; rcall sendregisterstolaptop ; to indicate end of an event, for debugging

    subi r17, 1
    sbci r18, 0

    mov r16, r17
    or r16, r18
    brne next_item ; more events to process!

    ; we're done

done:
    ; maybe wait for a while then restart, idk TODO
    rjmp done


; subroutines

wait_1ms:
    ; 4-cycle loop, 16000 cycles, therefore 16000/4 = 4000 iterations, 0x0FA0
    ldi r21, 0xA0
    ldi r22, 0x0F

wait_1ms_loop:
    subi r21, 1
    sbci r22, 0
    brne wait_1ms_loop
    ret

wait_duration:
    ; wait for duration in Y
    ; first copy Y to our own registers so we dont modify Y
    mov r19, YL
    mov r20, YH

wait_duration_loop:
    ; wait 1ms
    rcall wait_1ms

    subi r19, 1
    sbci r20, 0
    brne wait_duration_loop
    ret

play_note:
    ; play note with frequency in X for duration in Y
    ; X contains the OCR1A value for the note frequency, precalculated by python

    rcall note_on
    rcall wait_duration
    rcall note_off

    ret


note_on:
    ; turn on note with frequency in X
    ; configure timer1

    ; connect OC1A to pin 9
    ldi r23, 0b01000000
    sts TCCR1A, r23

    ; reset timer1 counter
    ldi r23, 0x00
    sts TCNT1H, r23
    sts TCNT1L, r23

    ; set OCR1A to frequency in X
    sts OCR1AH, XH
    sts OCR1AL, XL

    ; set timer1 to CTC mode, toggle OC1A on compare match, prescaler = 0b001 (no prescaling)
    ldi r23, 0b00001001 ; 0x09, CTC mode, toggle OC1A on compare match, prescaler = 1
    sts TCCR1B, r23


    ret

note_off:
    ; turn off note with frequency in X

    ; turn off timer1
    ldi r23, 0b00000000 ; 0x00, stop
    sts TCCR1B, r23
    sts TCCR1A, r23

    ret

