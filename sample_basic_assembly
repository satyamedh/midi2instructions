.device atmega328p

.equ DDRB = 4
.equ PORTB = 5

.def XL = r26
.def XH = r27

.def YL = r28
.def YH = r29

.def ZL = r30
.def ZH = r31

; apparently AVRA doesn't know about X, Y, and Z smh

ldi r16,$30 ; 0011 0000
out DDRB,r16

ldi r16,$20 ; 0011 0000
out PORTB,r16

; test waiting for 1s
; load 1000(0x03e8) into Y, and call wait_duration
;testtt:
;    ldi YL, 0xE8
