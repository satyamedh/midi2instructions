.device atmega328p

; mmio registers
.equ DDRB = 0x04
.equ PORTB = 0x05

.equ TCCR1A = 0x80
.equ TCCR1B = 0x81
.equ TCNT1L = 0x84
.equ TCNT1H = 0x85
.equ OCR1AL = 0x88
.equ OCR1AH = 0x89

; 16-bit register pairs
.def XL = r26
.def XH = r27

.def YL = r28
.def YH = r29

.def ZL = r30
.def ZH = r31


ldi r16,$3F ; 0011 1111, unsure which one is pin 9
out DDRB,r16 ; set to output

; Z = r31:r30
; we need to read midi_events(which is in program memory since we've just declared it with .dw),
; thus we need to use the `lpm` instruction for this. `lpm` only works with the Z register pair,
; so we need to set Z to point to the start of midi_events.

ldi ZL, LOW(midi_events * 2) ; *2 because we're using dw and the address is in bytes. 1 dw = 2 bytes
ldi ZH, HIGH(midi_events * 2)

; Initialize counter
ldi r17, LOW(num_events)
ldi r18, HIGH(num_events)

next_item:
    ; use X for frequency, Y for duration
    ; read from Z, and use the post-increment feature to SAVE CYCLES!

    lpm XL, Z+ ; frequency
    lpm XH, Z+
    lpm YL, Z+ ; duration
    lpm YH, Z+

    ; now, X = frequency, Y = duration

    ; check if frequency is zero
    ; a zero frequency means no note should be played.
    mov r16, XH
    or r16, XL
    breq wait_event

    ; frequency is not zero, so we need to play a note
    rcall play_note
    rjmp finisher

wait_event:
    ; wait for duration in Y
    rcall wait_duration

finisher:
    ; decrement counter
    subi r17, 1
    sbci r18, 0

    ; check if we're done
    mov r16, r17
    or r16, r18
    brne next_item ; more events to process!

    ; we're done

done:
    rjmp done

; subroutines

wait_1ms:
    ; 4-cycle loop, 16000 cycles @ 16MHz, therefore 16000/4 = 4000 iterations, 0x0FA0
    ; however, we have overhead of the function header, return and the rcall to here.
    ; total overhead is 2(header) + 4(return) + 3(rcall) = 9 cycles
    ; add 3 nops to make it 12 cycles of overhead, then we can remove 3 iterations, thus 3997 iterations, which is 0x0F9D
    nop           ; 1 overhead cycle
    nop           ; 1 overhead cycle
    nop           ; 1 overhead cycle
    ldi r21, 0x9D ; 1 overhead cycle
    ldi r22, 0x0F ; 1 overhead cycle

wait_1ms_loop:
    subi r21, 1         ; 1 cycle
    sbci r22, 0         ; 1 cycle
    brne wait_1ms_loop  ; 2 cycles if branch taken(which is always except for the last iteration), 1 otherwise
    ; thus, the regular loop takes 4 cycles.
    ; last cycle takes 3, so add a nop to compensate
    nop ; compensated cycle
    ret ; 4 cycles overhead


wait_duration:
    ; wait for duration in Y
    ; first copy Y to our own registers so we dont modify Y
    mov r19, YL
    mov r20, YH

wait_duration_loop:
    ; wait 1ms Y times
    rcall wait_1ms

    subi r19, 1
    sbci r20, 0
    brne wait_duration_loop
    ret
    ; technically, there's some error with the overhead of this loop, but compared to hundreds of milliseconds, it's negligible.
    ; (and I'm lazy)

play_note:
    ; play note with frequency in X for duration in Y
    ; X contains the OCR1A value for the note frequency, precalculated by python

    rcall note_on
    rcall wait_duration
    rcall note_off

    ret


note_on:
    ; turn on note with frequency in X
    ; configure timer1

    ; connect OC1A to pin 9
    ldi r23, 0b01000000
    sts TCCR1A, r23

    ; reset timer1 counter
    ldi r23, 0x00
    sts TCNT1H, r23
    sts TCNT1L, r23

    ; set OCR1A to frequency in X
    sts OCR1AH, XH
    sts OCR1AL, XL

    ; need to use sts instead of out since out only works till 0x3F, and OCR1A is at 0x88

    ; set timer1 to CTC mode, toggle OC1A on compare match, prescaler = 0b001 (no prescaling)
    ldi r23, 0b00001001
    sts TCCR1B, r23

    ; CTC auto-clears the timer after matching with OCR1A
    ; auto-toggle... automatically toggles the output pin on compare match, which is what we want for a square wave
    ; so we don't have to deal with interrupts
    ; prescaler just divides the clock in case our OCR1A value is greater than 0xFFFF. Didn't end up needing it for rickroll

    ret

note_off:
    ; turn off note with frequency in X

    ; just turn off timer1
    ldi r23, 0b00000000 ; 0x00, stop
    sts TCCR1B, r23
    sts TCCR1A, r23

    ret

